# ============================================================
# Docker 部署配置模板 — 复制为 .env 并修改实际值
# ============================================================

# --- Image Registry ---
# 生产部署时指向 ACR，本地开发留空使用 docker compose build
REGISTRY=

# --- Deployment Mode ---
# small = 1.8GB 轻量服务器 (Alibaba Cloud ECS / AWS t3.small)
# normal = 4GB+ 标准服务器
# 影响: MySQL/Redis 内存分配, JVM GC 策略
SERVER_SIZE=small

# --- Frontend Ports ---
ADMIN_PORT=3000
CUSTOMER_PORT=80

# --- Backend Service Ports ---
CORE_PORT=8081
TEMPLATE_PORT=8082
SERVER_PORT=8083

# --- Database ---
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=auth_system
MYSQL_PORT=3306
DB_USERNAME=auth_user
DB_POOL_SIZE=10
DB_POOL_MIN=3

# --- Redis ---
REDIS_PASSWORD=change_me_too
REDIS_PORT=6379

# --- Backend ---
SPRING_PROFILES_ACTIVE=prod
DB_HOST=mysql
REDIS_HOST=redis

# --- JVM Options ---
# small server: G1GC, 60% max RAM (default)
# normal server: ZGC, 75% max RAM — set JAVA_OPTS=-XX:+UseZGC -XX:MaxRAMPercentage=75
JAVA_OPTS=-XX:+UseG1GC -XX:MaxRAMPercentage=60 -XX:InitialRAMPercentage=40

# --- AES Encryption Keys (required) ---
AES_KEY_V0=change_me_aes_v0
AES_KEY_V1=change_me_aes_v1

# --- GeeTest Captcha (required for registration/login) ---
# 从 GeeTest 控制台获取: https://www.geetest.com/
GEETEST_SKIP_VERIFICATION=false
GEETEST_LOGIN_CAPTCHA_ID=your_captcha_id
GEETEST_LOGIN_CAPTCHA_KEY=your_captcha_key
GEETEST_REGISTER_CAPTCHA_ID=your_captcha_id
GEETEST_REGISTER_CAPTCHA_KEY=your_captcha_key

# --- SMTP Mail (required for email verification) ---
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=your_smtp_password

# --- Steam Web API (required for Workshop mod search & cache) ---
# 从 https://steamcommunity.com/dev/apikey 获取
STEAM_API_KEY=

# --- CORS (set to your server's public URL, e.g. http://106.15.53.246) ---
CORS_ALLOWED_ORIGINS=

# --- JVM Network Proxy (set empty outside corporate network) ---
# 中兴内网代理配置（外网部署请留空）：
# JAVA_TOOL_OPTIONS=-Dhttp.proxyHost=proxyhk.zte.com.cn -Dhttp.proxyPort=80 -Dhttps.proxyHost=proxyhk.zte.com.cn -Dhttps.proxyPort=80 -Dhttp.nonProxyHosts=localhost|127.0.0.1|mysql|redis|*.zte.com.cn|*.zte.intra|10.0.0.0/8
JAVA_TOOL_OPTIONS=

# --- Docker Build Proxy (set empty outside corporate network) ---
# 中兴内网代理配置（外网部署请留空）：
# HTTP_PROXY=http://proxyhk.zte.com.cn:80
# HTTPS_PROXY=http://proxyhk.zte.com.cn:80
# NO_PROXY=localhost,127.0.0.1,*.zte.com.cn,*.zte.intra,10.0.0.0/8
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=
