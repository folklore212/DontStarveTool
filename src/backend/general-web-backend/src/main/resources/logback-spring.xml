<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProfile name="!prod">
        <include resource="org/springframework/boot/logging/logback/base.xml"/>
    </springProfile>
    <springProfile name="prod">
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <!-- Exclude PII/sensitive fields from structured log output -->
                <excludeMdcKeyName>password</excludeMdcKeyName>
                <excludeMdcKeyName>newPassword</excludeMdcKeyName>
                <excludeMdcKeyName>oldPassword</excludeMdcKeyName>
                <excludeMdcKeyName>credential</excludeMdcKeyName>
                <excludeMdcKeyName>token</excludeMdcKeyName>
                <excludeMdcKeyName>accessToken</excludeMdcKeyName>
                <excludeMdcKeyName>refreshToken</excludeMdcKeyName>
                <excludeMdcKeyName>rawKey</excludeMdcKeyName>
                <excludeMdcKeyName>secret</excludeMdcKeyName>
                <excludeMdcKeyName>email</excludeMdcKeyName>
                <excludeMdcKeyName>phone</excludeMdcKeyName>
                <excludeMdcKeyName>identifier</excludeMdcKeyName>
                <fieldNames>
                    <timestamp>@timestamp</timestamp>
                    <message>message</message>
                    <level>level</level>
                </fieldNames>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="JSON"/>
        </root>
    </springProfile>
</configuration>
